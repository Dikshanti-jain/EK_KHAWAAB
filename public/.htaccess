# ====================================================================
# EK KHAWAAB — High-Performance .htaccess for Apache & Static Crawlers
# Ensures Fast Indexing, XML/TXT MIME Types, Googlebot Access & Security
# ====================================================================

# 1. UTF-8 & Proper MIME Types for Search Engine Crawlers
AddDefaultCharset UTF-8
AddType text/plain;charset=UTF-8 .txt
AddType application/xml;charset=UTF-8 .xml
AddType text/html;charset=UTF-8 .html
AddType image/svg+xml .svg
AddType image/webp .webp
AddType image/png .png
AddType image/x-icon .ico

# 2. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ek-khawaab\.vercel\.app$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Direct pass-through for robots.txt, sitemaps, and Google verification files
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^google[a-zA-Z0-9_-]+\.html$ - [L]
</IfModule>

# 3. Crawler Headers & Indexation Directives
<IfModule mod_headers.c>
  # Tell Googlebot and all search engines to index and follow
  <FilesMatch "\.(html|htm)$">
    Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  </FilesMatch>

  # Explicit indexing headers for sitemap.xml and robots.txt
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set X-Robots-Tag "all"
    Header set Cache-Control "public, max-age=3600, s-maxage=86400"
  </Files>

  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set X-Robots-Tag "all"
    Header set Cache-Control "public, max-age=3600, s-maxage=86400"
  </Files>

  # Allow Google site verification file to be read directly without framing issues
  <FilesMatch "^google[a-zA-Z0-9_-]+\.html$">
    Header set Content-Type "text/html; charset=utf-8"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression for Faster Crawl Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/css
</IfModule>
