<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www to non-www (Canonical https://ekkhawaab.in)
  RewriteCond %{HTTP_HOST} ^www\.ekkhawaab\.in$ [NC]
  RewriteRule ^ https://ekkhawaab.in%{REQUEST_URI} [L,R=301]

  # 3. Serve pre-rendered directory index.html if it exists (e.g., /dictionary/tagaful -> /dictionary/tagaful/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 4. Serve existing static files (assets, sitemap.xml, robots.txt, images) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. SPA Fallback for dynamic client-side routes
  RewriteRule ^ /index.html [L]
</IfModule>

# Correct MIME Types for SEO files
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Security Headers for Hostinger LiteSpeed
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.onrender.com https://api.ekkhawaab.in;"
</IfModule>

# Browser Caching for Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

