# EK KHAWAAB — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or configure these variables in your Vercel Dashboard

# ----------------------------------------------------
# 1. SUPABASE CLIENT & BACKEND CONFIGURATION
# ----------------------------------------------------
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_URL="https://your_project_id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# ----------------------------------------------------
# 2. GROQ AI SHAYAR CONFIGURATION (RECOMMENDED FOR HIGH SPEED & SPECIFICITY)
# ----------------------------------------------------
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# ----------------------------------------------------
# 3. LEGACY / FALLBACK AI KEYS (OPTIONAL)
# ----------------------------------------------------
OPENAI_API_KEY=""
LOVABLE_API_KEY=""

# ----------------------------------------------------
# 4. DEPLOYMENT TARGET
# Set to "vercel" for Vercel Serverless Function builds
# ----------------------------------------------------
NITRO_PRESET="vercel"
